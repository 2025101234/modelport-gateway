    "@types/react-dom": "19.3.0",
    "clsx": "2.1.1",
    "esbuild": "0.25.9",
    "lucide-react": "1.53.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vite": "7.3.7"
